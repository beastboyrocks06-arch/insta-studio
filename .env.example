PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Local app sign-in. Keep the real values in .env only; never commit .env.
APP_USERNAME=admin@example.com
APP_PASSWORD=Admin@123

# --- Meta (Instagram Login) - needed to connect accounts ---
META_APP_ID=940036942071845
META_APP_SECRET=9beb162b5e29005ca4112b83d9b14b8c
# Must match EXACTLY what you add in the Meta dashboard
META_REDIRECT_URI=https://instabuddy-62uq.onrender.com/api/ig/callback

# instagram = Instagram API with Instagram Login (no Facebook Page needed)
# facebook  = Instagram API with Facebook Login (needs a Page linked to the IG account)
META_LOGIN_TYPE=instagram
META_GRAPH_API_VERSION=v21.0

# Optional override (comma separated). Defaults:
# instagram: instagram_business_basic,instagram_business_content_publish
# facebook:  pages_show_list,pages_read_engagement,instagram_basic,instagram_content_publish
META_SCOPES=instagram_business_basic,instagram_business_content_publish

# Required for direct signed media uploads
